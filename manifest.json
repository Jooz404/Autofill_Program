{
  "manifest_version": 3,
  "name": "Pertamina S&D Autofill Assistant (Multi-Tab)",
  "version": "2.0",
  "description": "Sistem otomatisasi penginputan data Penyaluran RSD Pertamina Patra Niaga (Multi-Tab Master-Worker).",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://sndone.patraniaga.com/*"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sndone.patraniaga.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}